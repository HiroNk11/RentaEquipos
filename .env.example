# Plantilla para contenedor. Reemplazar valores; no contiene credenciales reales.
ASPNETCORE_ENVIRONMENT=Production
AllowedHosts=api.example.invalid
Authentication__Authority=https://identity.example.invalid
Authentication__Audience=alquiler-equipos
Authentication__RoleClaimType=role
ConnectionStrings__AlquilerEquipos=Server=sql.example.invalid;Database=AlquilerEquiposDB;User Id=alquiler_app;Password=REEMPLAZAR;Encrypt=True;TrustServerCertificate=False
Cors__AllowedOrigins__0=https://web.example.invalid
# Usar la IP real del proxy TLS; no una red completa.
ReverseProxy__KnownProxies__0=10.0.0.10

