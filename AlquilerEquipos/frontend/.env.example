VITE_API_URL=/api
VITE_DEMO_MODE=false
VITE_ALLOW_ANONYMOUS_API=false
VITE_WINDOWS_LOCAL=false
VITE_CURRENCY=ARS

# SPA publica con Authorization Code + PKCE. Nunca colocar client secrets aqui.
VITE_OIDC_AUTHORITY=
VITE_OIDC_CLIENT_ID=
VITE_OIDC_SCOPE=openid profile
VITE_OIDC_AUDIENCE=
VITE_OIDC_ROLE_CLAIM=role
VITE_OIDC_REDIRECT_URI=http://127.0.0.1:5173/
